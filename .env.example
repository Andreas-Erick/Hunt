# Hunt — Optional Runtime Configuration
# Copy to `.env.local` if you want to override any default.
# All variables are optional; Hunt runs out of the box with zero configuration.

# Directory where the local sync server stores `hunt-sync.json`,
# the auto-generated pairing secret (`hunt-sync.key`), and 14-day backup snapshots.
# Default: ./data
# HUNT_DATA_DIR=./data

# Server-side structured diagnostic log threshold: DEBUG | INFO | WARN | ERROR | FATAL
# Default: INFO (WARN under NODE_ENV=test)
# LOG_LEVEL=INFO

# Browser-side structured diagnostic log threshold: DEBUG | INFO | WARN | ERROR | FATAL
# Default: INFO
# NEXT_PUBLIC_LOG_LEVEL=INFO
