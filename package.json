{
  "name": "hunt",
  "version": "1.17.0",
  "private": true,
  "description": "Local-first focus timer, habits and weekly quests. Windows desktop + Android, synced over LAN.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Andreas-Erick/Hunt.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:mobile-core": "node scripts/build-mobile-core.mjs",
    "start": "next start",
    "lint": "eslint --max-warnings 0 src e2e e2e-web scripts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:quiet": "vitest run --reporter=dot --silent",
    "test:geometry": "playwright test",
    "screenshots": "playwright test -c playwright.screenshots.config.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "prepare": "node scripts/install-hooks.mjs",
    "hunt": "Start-Hunt.bat",
    "build:web": "node scripts/build-web-demo.mjs",
    "preview:web": "node scripts/serve-web-demo.mjs",
    "test:web-demo": "playwright test -c playwright.webdemo.config.ts"
  },
  "dependencies": {
    "dexie": "^4.0.10",
    "dexie-react-hooks": "^1.1.7",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "next": "^16.4.6",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.7",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "esbuild": "0.21.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^7.0.2",
    "vitest": "^2.1.8"
  }
}
