<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.hunt.companion"
    android:versionCode="28"
    android:versionName="1.17.0">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />

    <!-- Universal Phone, Tablet & Foldable screen support (no compatibility letterboxing on tablets) -->
    <supports-screens
        android:smallScreens="true"
        android:normalScreens="true"
        android:largeScreens="true"
        android:xlargeScreens="true"
        android:anyDensity="true" />

    <!-- Required to sync with Laptop over local Wi-Fi / Hotspot -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Connectivity checks (getActiveNetwork, VPN detection, default-network callback) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!--
        Reminders (ADR-0007): posting notifications (asked for at runtime from Android 13), exact
        alarms (a settings switch from Android 12, asked for the first time a reminder is set) and
        re-arming the alarm after a reboot.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        enableOnBackInvokedCallback="false": keep the legacy Activity.onBackPressed() dispatch
        (MainActivity asks the page via window.__huntBack first). Explicit so predictive back /
        OnBackInvokedCallback never takes over the Back key at this targetSdk (34).
        Backup rules: the state file is backed up, the sync token file never leaves the device.
    -->
    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="false"
        android:theme="@style/Theme.HuntCompanion">

        <!--
            configChanges: the page draws its own fixed dark theme and adapts to any size, so
            rotation, split-screen/foldable resizing, keyboards and dark-mode (uiMode) switches
            are handled in place instead of recreating the Activity and reloading the page.
            (density / fontScale are left out on purpose: recreation keeps WebView in sync.)
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- One-tap local LAN/Tailscale pairing handoff from the scanned QR browser page -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="hunt"
                    android:host="pair" />
            </intent-filter>
        </activity>

        <!--
            Day Widget (ADR-0006). Not exported: the system still delivers the appwidget and
            time broadcasts, and the midnight alarm is an explicit intent. Never rename these
            classes, or placed widgets disappear on update.
        -->
        <receiver
            android:name=".DayWidgetProvider"
            android:label="@string/day_widget_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/day_widget_info" />
        </receiver>
        <service
            android:name=".DayWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
        <!--
            Day Widget row taps (tick, Undo, open Hunt) land here, a no-UI trampoline, instead of
            a broadcast: a receiver opening Hunt would be a blocked background activity launch.
            Not exported, no intent filter: only the widget's own PendingIntent reaches it.
        -->
        <activity
            android:name=".DayWidgetTapActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <!--
            Stats Widget (optional; the user adds it if they want it). Not exported, like the Day
            Widget. Never rename the class, or placed widgets disappear on update.
        -->
        <receiver
            android:name=".StatsWidgetProvider"
            android:label="@string/stats_widget_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/stats_widget_info" />
        </receiver>

        <!--
            Reminder alarm (ADR-0007), and the broadcasts after which it is armed again. Not
            exported: the system still delivers these, and the alarm is an explicit intent. Never
            rename the class: an armed alarm names it.
        -->
        <receiver
            android:name=".ReminderAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!--
            A reminder notification's Done, +1 and Snooze (ADR-0007). Not exported: only the
            notification's explicit, immutable PendingIntents reach it. Never rename the class:
            a posted notification's actions name it.
        -->
        <receiver
            android:name=".ReminderActionReceiver"
            android:exported="false" />

    </application>

</manifest>
