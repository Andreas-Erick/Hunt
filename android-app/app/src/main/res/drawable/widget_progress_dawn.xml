<?xml version="1.0" encoding="utf-8"?>
<!--
    Stats Widget Quest progress, Dawn look: track in surface step 3, fill in gold (the only accent). The fill
    cannot be tinted per Quest before API 31, so the row's dot carries the Quest's own accent.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_dawn_pressed" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/widget_dawn_accent" />
                <corners android:radius="3dp" />
            </shape>
        </clip>
    </item>
</layer-list>
