<?xml version="1.0" encoding="utf-8"?>
<!--
    Dawn Undo target: a 32dp outlined pill (accent@28%) centred in the 48dp target, pressed: the
    accent ripple over the whole target.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/widget_dawn_ripple">
    <item>
        <inset
            android:insetBottom="8dp"
            android:insetLeft="4dp"
            android:insetRight="4dp"
            android:insetTop="8dp">
            <shape android:shape="rectangle">
                <stroke android:width="1dp" android:color="@color/widget_dawn_accent_edge" />
                <corners android:radius="16dp" />
            </shape>
        </inset>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="@dimen/widget_inner_radius" />
        </shape>
    </item>
</ripple>
