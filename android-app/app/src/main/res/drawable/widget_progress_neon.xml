<?xml version="1.0" encoding="utf-8"?>
<!--
    Stats Widget Quest progress, Neon look: a 4dp track in ink@8% (the app's hero bar) with the fill in
    the accent. From API 31 StatsWidgetProvider tints the fill with the Quest's accent; before that the
    row's dot alone carries it.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_neon_track" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/widget_neon_accent" />
                <corners android:radius="2dp" />
            </shape>
        </clip>
    </item>
</layer-list>
