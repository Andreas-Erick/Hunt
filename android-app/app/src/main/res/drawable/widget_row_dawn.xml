<?xml version="1.0" encoding="utf-8"?>
<!-- Dawn row: surface step 2 with a gold ripple as the pressed feedback (no theme attributes). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/widget_dawn_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_dawn_row" />
            <corners android:radius="@dimen/widget_inner_radius" />
        </shape>
    </item>
</ripple>
