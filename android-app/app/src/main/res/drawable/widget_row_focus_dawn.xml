<?xml version="1.0" encoding="utf-8"?>
<!-- Dawn Day Widget row for the Focus Task: the row card with the accent@28% edge of the app's spotlight card. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/widget_dawn_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_dawn_row" />
            <stroke android:width="1dp" android:color="@color/widget_dawn_accent_edge" />
            <corners android:radius="@dimen/widget_inner_radius" />
        </shape>
    </item>
</ripple>
