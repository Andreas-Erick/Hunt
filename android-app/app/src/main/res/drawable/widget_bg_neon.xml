<?xml version="1.0" encoding="utf-8"?>
<!--
    Neon widget ground: a top-lit fill (ground at the top easing to the deep surface at the
    bottom, the app's raised-card light) and the 1dp edge (cyan@25%, the HUD glow RemoteViews cannot draw as a shadow).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="@color/widget_neon_deep"
        android:startColor="@color/widget_neon_ground"
        android:type="linear" />
    <stroke android:width="1dp" android:color="@color/widget_neon_outline" />
    <corners android:radius="@dimen/widget_radius" />
</shape>
