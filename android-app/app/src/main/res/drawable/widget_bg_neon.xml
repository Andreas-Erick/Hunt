<?xml version="1.0" encoding="utf-8"?>
<!-- Neon widget ground: fill plus a 1dp cyan@25% ring (the HUD glow RemoteViews cannot draw as a shadow). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/widget_neon_ground" />
    <stroke android:width="1dp" android:color="@color/widget_neon_outline" />
    <corners android:radius="@dimen/widget_radius" />
</shape>
