<?xml version="1.0" encoding="utf-8"?>
<!--
    Dawn day switcher: one 40dp pill (inset in the 48dp header) behind the two 48dp arrow targets,
    a flat surface-step-2 fill like the app's segmented control, no hairline.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetBottom="4dp"
    android:insetTop="4dp">
    <shape android:shape="rectangle">
        <solid android:color="@color/widget_dawn_row" />
        <corners android:radius="20dp" />
    </shape>
</inset>
