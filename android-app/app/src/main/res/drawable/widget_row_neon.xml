<?xml version="1.0" encoding="utf-8"?>
<!-- Neon Day Widget row: a flat card one surface step above the ground (no hairline: the widget edge already frames the list), pressed: the accent ripple. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/widget_neon_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_neon_row" />
            <corners android:radius="@dimen/widget_inner_radius" />
        </shape>
    </item>
</ripple>
