<?xml version="1.0" encoding="utf-8"?>
<!--
    Widget colours per look, mirroring the CSS tokens of hunt-mobile.html (ADR-0005).
    Names: widget_<look>_<role>. Java picks the set by the Widget Snapshot's look; it never
    holds a hex literal. Neon ships first; Dawn adds its own widget_dawn_* set.
-->
<resources>
    <!-- Neon surfaces: deep 0 -> ground 1 -> row 2 -> pressed 3 (each step about +3-4% lightness) -->
    <color name="widget_neon_deep">#FF08090C</color>
    <color name="widget_neon_ground">#FF111319</color>
    <color name="widget_neon_row">#FF161922</color>
    <color name="widget_neon_pressed">#FF1C202B</color>
    <color name="widget_neon_glow">#4000F0FF</color>
    <color name="widget_neon_ripple">#3300F0FF</color>

    <!-- Neon ink -->
    <color name="widget_neon_text">#FFF8FAFC</color>
    <color name="widget_neon_text_2">#FFCBD5E1</color>
    <color name="widget_neon_muted">#FF94A3B8</color>
    <color name="widget_neon_dim">#FF7C8AA0</color>
    <color name="widget_neon_accent">#FF00F0FF</color>
    <color name="widget_neon_success">#FF00FF9D</color>

    <!-- Neon Quest accents (bars, rings and dots only: slate is below 4.5:1 as text) -->
    <color name="widget_neon_q_cyan">#FF00F0FF</color>
    <color name="widget_neon_q_emerald">#FF00FF9D</color>
    <color name="widget_neon_q_amber">#FFFFB800</color>
    <color name="widget_neon_q_purple">#FFB388FF</color>
    <color name="widget_neon_q_rose">#FFFF6B9D</color>
    <color name="widget_neon_q_sky">#FF38BDF8</color>
    <color name="widget_neon_q_orange">#FFFF8547</color>
    <color name="widget_neon_q_lime">#FFA3E635</color>
    <color name="widget_neon_q_slate">#FF64748B</color>
</resources>
