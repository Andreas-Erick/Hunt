<?xml version="1.0" encoding="utf-8"?>
<!--
    One Day Widget row, Dawn look, drawn as a card like the app's queue cards: the Quest accent
    bar on the left edge, a 48dp marker box (the open ring, or the play mark for the Focus Task),
    the one-line title (ellipsized) and an optional Focus/Habit pill. The Focus Task's card and
    pill take the accent edge (WidgetLook.focusRow / focusTag).
    The marker box is the tick target (48x48dp, not for the Focus Task); the rest of the row
    opens Hunt. The title starts after the marker box, so the two targets never overlap.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_row"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:minHeight="48dp"
    android:background="@drawable/widget_row_dawn"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingEnd="12dp">

    <ImageView
        android:id="@+id/widget_row_bar"
        android:layout_width="3dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_bar" />

    <FrameLayout
        android:id="@+id/widget_row_tick"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:background="@drawable/widget_tick_dawn">

        <ImageView
            android:id="@+id/widget_row_ring"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_ring"
            android:tint="@color/widget_dawn_ring"
            android:tintMode="src_in" />

        <ImageView
            android:id="@+id/widget_row_focus_mark"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_play"
            android:tint="@color/widget_dawn_accent"
            android:tintMode="src_in"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/widget_row_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:paddingStart="2dp"
        android:paddingEnd="8dp"
        android:textColor="@color/widget_dawn_text"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/widget_row_tag"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:background="@drawable/widget_tag_dawn"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:letterSpacing="0"
        android:maxLines="1"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:textAllCaps="false"
        android:textColor="@color/widget_dawn_muted"
        android:textSize="11sp"
        android:visibility="gone" />
</LinearLayout>
