<?xml version="1.0" encoding="utf-8"?>
<!--
    Day Widget, Neon look, populated or empty day. View ids are shared by every look's layout
    (widget_day_dawn.xml is its twin: keep both in step), so Java only picks the layout.
    Header (48dp): the day title on the left (open-Hunt target; an image in the app's display type,
    drawn by WidgetDisplayText, since a widget's TextView cannot load res/font), then the
    day switcher on the right: one pill holding the previous- and next-day arrows, each a 48dp
    square, 8dp clear of the title; at today and today + 6 an arrow stays in place, dimmed.
    Body: the selected day's rows as cards 8dp apart; widget_empty is its empty view
    ("Nothing left for Tue 24") under a Done mark.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_neon"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_header"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:background="@drawable/widget_header_neon"
            android:contentDescription="@string/day_widget_open_hunt"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:scaleType="fitStart" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/widget_nav_neon"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_prev"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:background="@drawable/widget_tick_neon"
                android:contentDescription="@string/day_widget_prev"
                android:scaleType="center"
                android:src="@drawable/widget_chevron_left" />

            <ImageView
                android:id="@+id/widget_next"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:background="@drawable/widget_tick_neon"
                android:contentDescription="@string/day_widget_next"
                android:scaleType="center"
                android:src="@drawable/widget_chevron_right" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/widget_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@android:color/transparent"
            android:dividerHeight="8dp"
            android:listSelector="@android:color/transparent"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/widget_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:drawableTop="@drawable/widget_done_big_neon"
            android:drawablePadding="10dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:textColor="@color/widget_neon_muted"
            android:textSize="14sp" />
    </FrameLayout>
</LinearLayout>
