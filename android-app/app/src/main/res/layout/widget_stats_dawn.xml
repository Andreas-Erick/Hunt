<?xml version="1.0" encoding="utf-8"?>
<!--
    Stats Widget, Dawn look: the twin of widget_stats_neon.xml with the same view ids and geometry
    (androidWidgetLook.test.ts), so Java only picks the layout. Sentence-case labels, tabular sans
    figures (tnum) in place of Neon's mono, gold as the only accent. The whole widget is one
    open-Hunt target; the rows inside are not targets and may be smaller than 48dp.
    Header: section label + today's Quest focus time (big tabular figures).
    Quests: up to 3 fixed rows (dot in the Quest accent, code, progress bar, "5.5 / 8h"), then
    "+N more", or the no-Quests line. Streaks: a label with "+N more" on the right, then up to 8
    fixed rows. StatsWidgetProvider shows as many rows as the widget's height allows; keep the
    row heights here in step with its *_DP constants and its id arrays.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_stats_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="48dp"
    android:background="@drawable/widget_stats_bg_dawn"
    android:contentDescription="@string/day_widget_open_hunt"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/stats_widget_week"
            android:textColor="@color/widget_dawn_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_stats_focus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:text="0m"
            android:textColor="@color/widget_dawn_accent"
            android:textSize="24sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:text="@string/stats_widget_today"
            android:textColor="@color/widget_dawn_dim"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_stats_no_quests"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/stats_widget_no_quests"
        android:textColor="@color/widget_dawn_muted"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
