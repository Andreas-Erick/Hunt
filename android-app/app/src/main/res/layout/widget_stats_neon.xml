<?xml version="1.0" encoding="utf-8"?>
<!--
    Stats Widget, Neon look. View ids are look-neutral (widget_stats_dawn.xml is its twin with the
    same ids and geometry: keep both in step), so Java only picks the layout. The whole widget is
    one open-Hunt target; the rows inside are not targets and may be smaller than 48dp.
    Hero (40dp): today's Quest focus time in big tabular display figures with "today" (one image
    in the app's display type, drawn by WidgetDisplayText; the root's description reads it), and
    the "This week" label over the hours column, like the app's hero stats pill.
    Quests: up to 3 fixed two-line rows (dot in the Quest accent, code, "5.5 / 8h"; the progress
    bar under them), then "+N more", or the no-Quests line. Streaks: a label with "+N more" on
    the right, then up to 8 fixed rows. StatsWidgetProvider shows as many rows as the widget's
    height allows; keep the row heights here in step with StatsWidgetFit's *_DP constants and
    StatsWidgetProvider's id arrays.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_stats_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="48dp"
    android:background="@drawable/widget_stats_bg_neon"
    android:contentDescription="@string/day_widget_open_hunt"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_stats_focus"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:scaleType="fitStart" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="8dp"
            android:paddingBottom="8dp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:letterSpacing="0.12"
            android:maxLines="1"
            android:text="@string/stats_widget_week"
            android:textAllCaps="true"
            android:textColor="@color/widget_neon_muted"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_stats_no_quests"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:text="@string/stats_widget_no_quests"
        android:textColor="@color/widget_neon_muted"
        android:textSize="13sp"
        android:visibility="gone" />

